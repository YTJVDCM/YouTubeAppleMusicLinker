{
  "name": "youtube-apple-music-linker",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "lint": "web-ext lint --source-dir dist/extension --warnings-as-errors",
    "package": "web-ext build --source-dir dist/extension --overwrite-dest",
    "test:distribution": "python3 -m unittest discover -s tests/distribution -p 'test_*.py'",
    "verify:distribution": "python3 scripts/verify_distribution.py",
    "version:distribution": "node scripts/distribution-version.mjs"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0"
  }
}
