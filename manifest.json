{
  "manifest_version": 3,
  "name": "YouTube → Apple Music Linker",
  "version": "0.2.3",
  "description": "YouTubeの動画からApple Musicの候補を探し、確認して開きます。",
  "permissions": ["storage", "tabs", "cookies"],
  "optional_host_permissions": ["https://itunes.apple.com/*", "https://musicbrainz.org/*"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://itunes.apple.com/*"],
  "background": { "scripts": ["dist/extension/background.js"] },
  "action": { "default_title": "Apple Music Linker：表示状態を確認", "default_popup": "dist/extension/popup.html" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["dist/extension/youtube.js"] }],
  "options_ui": { "page": "dist/extension/options.html", "open_in_tab": true },
  "browser_specific_settings": { "gecko": { "id": "youtube-apple-music-linker@local.invalid", "strict_min_version": "140.0",
    "data_collection_permissions": { "required": ["websiteContent", "browsingActivity"] } },
    "gecko_android": { "strict_min_version": "142.0" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
